# Read-only MongoDB account/URI for auditing MLS data. Never commit actual values.
MONGODB_URI=
# Compatibility with the existing data_service scripts; either variable is accepted.
MONGO_URI=
MONGO_DB=mls
MONGO_COLLECTION=mls_listings

# Optional read-only demo login for Flip Finder. The demo account is restricted
# to the ten curated demo pair keys and receives public-safe MLS fields only.
FLIP_UI_DEMO_USERNAME=demo
FLIP_UI_DEMO_PASSWORD=replace-with-a-long-random-password
